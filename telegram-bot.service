[Unit]
Description=Telegram Script Hosting Bot (24/7)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/telegram-bot
EnvironmentFile=/home/ubuntu/telegram-bot/.env
ExecStart=/home/ubuntu/telegram-bot/.venv/bin/python /home/ubuntu/telegram-bot/bot.py
Restart=always
RestartSec=5s
KillSignal=SIGINT
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
