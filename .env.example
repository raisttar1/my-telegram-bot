# =============================================================================
# Telegram Script-Hosting Bot — configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin/owner Telegram numeric chat ID (authorizes the Admin Panel + bypasses approval)
OWNER_ID=123456789

# Channel the user must join before using the bot (with leading @).
# Leave EMPTY to disable the membership gate.
CHANNEL_USERNAME=@your_channel

# Port for the Flask health server
PORT=8080

# Base directory for all persistent state (users, projects, venvs, logs)
BASE_DIR=./data

# =============================================================================
# Upload / archive limits (in MB)
# =============================================================================
MAX_UPLOAD_MB=20
MAX_ARCHIVE_MB=50
MAX_EXTRACTED_MB=200
MAX_ARCHIVE_ENTRIES=500
MAX_PROJECTS_PER_USER=10

# =============================================================================
# Process management
# =============================================================================
MAX_PROCESSES_PER_USER=2
MAX_GLOBAL_PROCESSES=10
EXECUTION_TIMEOUT=120
MAX_STORED_PROCESSES_PER_USER=25

# =============================================================================
# Logging / live output
# =============================================================================
MAX_LOG_BYTES=262144
LIVE_UPDATE_SECONDS=3

# =============================================================================
# Execution
# =============================================================================
# Execution backend: docker (default, recommended) or unsandboxed (UNSAFE)
EXECUTION_MODE=docker
# Only relevant when EXECUTION_MODE=unsandboxed. Disable unless you trust 100% of users.
ALLOW_UNSANDBOXED_EXECUTION=false
# Disable container network for the *run* phase (dependency install always needs network).
DOCKER_NETWORK_DISABLED=true

# Container images
DOCKER_IMAGE=python:3.11-slim
NODE_DOCKER_IMAGE=node:20-slim

# Resource limits applied to every sandbox container
DOCKER_CPUS=1.0
DOCKER_MEMORY=256m
DOCKER_PIDS=128
DOCKER_TMP_SIZE=64m

# =============================================================================
# Interactive stdin
# =============================================================================
STDIN_TIMEOUT_SECONDS=120
INPUT_WAIT_DETECT_SECONDS=8

# =============================================================================
# Misc
# =============================================================================
TERMINAL_TIMEOUT=15
LOG_LEVEL=INFO
